rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /chapters/alpha-psi {
      allow read, write: if request.auth != null;
    }

    match /chapterEnrollments/{enrollmentHash} {
      // First-time members may check only the exact hashed enrollment record
      // produced from their school email + Buff ID. Listing the collection
      // remains blocked while signed out.
      allow get: if true;
      allow list: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    match /chapterEnrollmentIndexes/alpha-psi {
      allow read, write: if request.auth != null;
    }
  }
}
